{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.*|logo.*|og-image.*|badge.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Crewloom-Agent-Setup.exe",
      "destination": "https://github.com/crewloom/crewloom.github.io/releases/download/v0.3.22/Crewloom-Agent-Setup.exe",
      "permanent": false
    },
    {
      "source": "/Crewloom-Desktop-Windows-x64.zip",
      "destination": "https://github.com/crewloom/crewloom.github.io/releases/download/v0.3.22/Crewloom-Desktop-Windows-x64.zip",
      "permanent": false
    },
    {
      "source": "/Crewloom.dmg",
      "destination": "https://github.com/crewloom/crewloom.github.io/releases/download/v0.3.22/Crewloom.dmg",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/docs/:match*",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/install",
      "destination": "/#install",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/#install",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:match*",
      "destination": "/:match*",
      "permanent": true
    },
    {
      "source": "/cdn-cgi/:match*",
      "destination": "/",
      "permanent": true
    }
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run test:cli && npm run build"
}
